<%-- Admin top header bar (static include): brand + user + sign out --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>

<header class="admin-topbar">
    <a class="brand" href="${ctx}/${sessionScope.currentUser.roleName == 'CHU_QUAN_QUAN_TRI' ? 'admin' : (sessionScope.currentUser.roleName == 'NHAN_VIEN_GIAO_HANG' ? 'delivery' : 'inventory')}" aria-label="PharmaFlow back office">
        <span class="brand-mark">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="8" width="18" height="13" rx="2" />
                <path d="M8 8V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3"/>
                <path d="M12 12v6M9 15h6"/>
            </svg>
        </span>
        <span class="brand-name">PharmaFlow</span>
        <span class="brand-tag">${sessionScope.currentUser.roleName == 'CHU_QUAN_QUAN_TRI' ? 'Quản trị' : (sessionScope.currentUser.roleName == 'NHAN_VIEN_GIAO_HANG' ? 'Giao hàng' : 'Nhân viên')}</span>
    </a>

    <div class="admin-topbar-actions">
        <a class="icon-btn" href="${ctx}/home" title="Xem cửa hàng">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
            <span class="icon-label">Cửa hàng</span>
        </a>
        <a class="icon-btn" href="${ctx}/authen?action=logout" title="Đăng xuất">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/>
            </svg>
            <span class="icon-label"><c:out value="${sessionScope.currentUser.fullName}"/></span>
        </a>
    </div>
</header>
