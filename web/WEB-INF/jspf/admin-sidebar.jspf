<%-- Admin sidebar (static include). Caller sets `adminNav` page attr to highlight. --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<aside class="admin-sidebar">
    <nav class="admin-nav" aria-label="Mục quản trị">
        <c:if test="${sessionScope.currentUser.roleName == 'CHU_QUAN_QUAN_TRI'}">
        <span class="admin-nav-label">Danh mục sản phẩm</span>
        <a class="admin-nav-link ${adminNav == 'products'   ? 'current' : ''}"
           href="${ctx}/admin?action=products">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>
            Sản phẩm</a>
        <a class="admin-nav-link ${adminNav == 'categories' ? 'current' : ''}"
           href="${ctx}/admin?action=categories">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            Danh mục</a>
        <a class="admin-nav-link ${adminNav == 'suppliers'  ? 'current' : ''}"
           href="${ctx}/admin?action=suppliers">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 8h14v9H1zM15 11h4l3 3v3h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="18" cy="19" r="1.6"/></svg>
            Nhà cung cấp</a>

        <span class="admin-nav-label">Mua hàng</span>
        <a class="admin-nav-link ${adminNav == 'purchase-orders' ? 'current' : ''}"
           href="${ctx}/admin/purchase-orders">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 2h6l1 3h4v16H4V5h4l1-3z"/><path d="M9 12h6M9 16h4"/></svg>
            Đơn đặt hàng</a>
        </c:if>

        <c:if test="${sessionScope.currentUser.roleName == 'NHAN_VIEN'}">
        <span class="admin-nav-label">Bán hàng</span>
        <a class="admin-nav-link ${adminNav == 'pos' ? 'current' : ''}"
           href="${ctx}/pos">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            Bán hàng (POS)</a>
        <a class="admin-nav-link ${adminNav == 'online-orders' ? 'current' : ''}"
           href="${ctx}/fulfillment">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2h12a1 1 0 0 1 1 1v18l-3-2-3 2-3-2-3 2-3-2V3a1 1 0 0 1 1-1z"/><path d="M9 7h6M9 11h6"/></svg>
            Đơn hàng trực tuyến</a>
        </c:if>

        <c:if test="${sessionScope.currentUser.roleName == 'NHAN_VIEN_GIAO_HANG'}">
        <span class="admin-nav-label">Giao hàng</span>
        <a class="admin-nav-link ${adminNav == 'delivery' ? 'current' : ''}"
           href="${ctx}/delivery">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 8h14v9H1zM15 11h4l3 3v3h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="18" cy="19" r="1.6"/></svg>
            Đơn giao hàng</a>
        </c:if>

        <c:if test="${sessionScope.currentUser.roleName == 'CHU_QUAN_QUAN_TRI' or sessionScope.currentUser.roleName == 'NHAN_VIEN'}">
        <span class="admin-nav-label">Kho</span>
        <a class="admin-nav-link ${adminNav == 'inventory' ? 'current' : ''}"
           href="${ctx}/inventory">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8M9 15.5l2 2 4-4"/></svg>
            Tồn kho</a>
        <a class="admin-nav-link ${adminNav == 'stock-receiving' ? 'current' : ''}"
           href="${ctx}/inventory/receipts">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8M9 15.5l2 2 4-4"/></svg>
            Nhập kho</a>
        <a class="admin-nav-link ${adminNav == 'inventory-adjustments' ? 'current' : ''}"
           href="${ctx}/inventory/adjustments">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            Điều chỉnh kho</a>
        <a class="admin-nav-link ${adminNav == 'stocktake' ? 'current' : ''}"
           href="${ctx}/inventory/stocktakes">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 14l2 2 4-4"/></svg>
            Kiểm kê</a>
        <a class="admin-nav-link ${adminNav == 'inventory-alerts' ? 'current' : ''}"
           href="${ctx}/inventory/alerts">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3l9.5 16.5H2.5L12 3z"/><path d="M12 10v5"/><circle cx="12" cy="18" r="0.6" fill="currentColor"/></svg>
            Cảnh báo tồn kho</a>
        <a class="admin-nav-link ${adminNav == 'inventory-history' ? 'current' : ''}"
           href="${ctx}/inventory?action=history">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Lịch sử kho</a>
        </c:if>

        <c:if test="${sessionScope.currentUser.roleName == 'CHU_QUAN_QUAN_TRI'}">
        <span class="admin-nav-label">Hệ thống</span>
        <a class="admin-nav-link ${adminNav == 'dashboard'  ? 'current' : ''}"
           href="${ctx}/admin">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="8" height="10" rx="1.5"/><rect x="13" y="3" width="8" height="6" rx="1.5"/><rect x="13" y="11" width="8" height="10" rx="1.5"/><rect x="3" y="15" width="8" height="6" rx="1.5"/></svg>
            Bảng điều khiển</a>
        <a class="admin-nav-link ${adminNav == 'reports' ? 'current' : ''}"
           href="${ctx}/reports">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 15v3M12 10v8M17 6v12"/></svg>
            Báo cáo</a>
        </c:if>
        <a class="admin-nav-link" href="${ctx}/home">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
            Cửa hàng</a>
    </nav>
</aside>
