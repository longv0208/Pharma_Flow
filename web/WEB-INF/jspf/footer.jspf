<%-- Shared footer fragment: trust badges + bottom bar --%>
<footer class="site-footer">
    <div class="container">
        <ul class="trust-badges">
            <li>
                <span class="badge-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
                </span>
                <div><strong>Genuine Products</strong><p>Sourced from licensed distributors</p></div>
            </li>
            <li>
                <span class="badge-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/><path d="M3 3h2l2.5 12.5h11L21 7H7"/></svg>
                </span>
                <div><strong>Easy Ordering</strong><p>Simple online checkout</p></div>
            </li>
            <li>
                <span class="badge-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L4.5 12.5H11L10 22l8.5-11.5H12L13 2z"/></svg>
                </span>
                <div><strong>Fast Delivery</strong><p>Same-day dispatch before 5pm</p></div>
            </li>
            <li>
                <span class="badge-icon" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 13c1.5 1.5 6.5 1.5 8 0M9 9h.01M15 9h.01"/></svg>
                </span>
                <div><strong>Pharmacist Support</strong><p>Chat with a licensed pharmacist</p></div>
            </li>
        </ul>
        <div class="footer-bar">
            <span>&copy; <%= java.time.Year.now() %> PharmaFlow. All rights reserved.</span>
        </div>
    </div>
</footer>
