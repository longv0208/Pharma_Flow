<%-- Shared header fragment: logo + categories dropdown + top nav --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>

<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="${ctx}/home" aria-label="PharmaFlow home">
            <span class="brand-mark">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="8" width="18" height="13" rx="2" />
                    <path d="M8 8V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3"/>
                    <path d="M12 12v6M9 15h6"/>
                </svg>
            </span>
            <span class="brand-name">PharmaFlow</span>
            <span class="brand-tag">Pharmacy</span>
        </a>

        <nav class="main-nav" aria-label="Primary">
            <div class="nav-categories">
                <button class="nav-categories-toggle" type="button" aria-haspopup="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                    </svg>
                    Categories
                    <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg>
                </button>
                <ul class="nav-categories-menu">
                    <c:choose>
                        <c:when test="${not empty categories}">
                            <c:forEach var="c" items="${categories}">
                                <li><a href="${ctx}/products?category=${c.categoryId}"><c:out value="${c.categoryName}"/></a></li>
                            </c:forEach>
                        </c:when>
                        <c:otherwise>
                            <li class="empty-hint">No categories yet</li>
                        </c:otherwise>
                    </c:choose>
                </ul>
            </div>

            <ul class="nav-links">
                <li><a href="${ctx}/home">Home</a></li>
                <li><a href="${ctx}/products">Medicines</a></li>
                <li><a href="${ctx}/products?tag=health">Health Care</a></li>
                <li><a href="${ctx}/products?tag=mother-baby">Mother &amp; Baby</a></li>
                <li>
                    <a href="${ctx}/products?promo=1">Promotions</a>
                    <span class="badge-sale">Sale</span>
                </li>
            </ul>
        </nav>

        <div class="header-actions">
            <%-- Cart route does not exist yet — render as disabled placeholder. --%>
            <span class="icon-btn disabled" title="Cart (coming soon)" aria-disabled="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/>
                    <path d="M3 3h2l2.5 12.5h11L21 7H7"/>
                </svg>
                <span class="icon-label">Cart</span>
            </span>
            <c:choose>
                <c:when test="${not empty sessionScope.currentUser}">
                    <a class="icon-btn" href="${ctx}/profile" title="My profile">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/>
                        </svg>
                        <span class="icon-label"><c:out value="${sessionScope.currentUser.fullName}"/></span>
                    </a>
                    <a class="icon-btn" href="${ctx}/authen?action=logout" title="Sign out">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/>
                        </svg>
                        <span class="icon-label">Sign Out</span>
                    </a>
                </c:when>
                <c:otherwise>
                    <a class="icon-btn" href="${ctx}/authen?action=login" title="Sign in">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/>
                        </svg>
                        <span class="icon-label">Sign In</span>
                    </a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>
