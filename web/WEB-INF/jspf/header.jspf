<%-- Shared header fragment: logo + categories dropdown + top nav --%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>

<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="${ctx}/home" aria-label="Trang chủ PharmaFlow">
            <span class="brand-mark">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="8" width="18" height="13" rx="2" />
                    <path d="M8 8V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3"/>
                    <path d="M12 12v6M9 15h6"/>
                </svg>
            </span>
            <span class="brand-name">PharmaFlow</span>
            <span class="brand-tag">Nhà thuốc</span>
        </a>

        <nav class="main-nav" aria-label="Chính">
            <div class="nav-categories">
                <button class="nav-categories-toggle" type="button" aria-haspopup="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                        <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                    </svg>
                    Danh mục
                    <svg width="10" height="10" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg>
                </button>
                <ul class="nav-categories-menu">
                    <c:choose>
                        <c:when test="${not empty categories}">
                            <c:forEach var="c" items="${categories}">
                                <li><a href="${ctx}/products?category=${c.categoryId}"><c:out value="${c.categoryName}"/></a></li>
                            </c:forEach>
                        </c:when>
                        <c:otherwise>
                            <li class="empty-hint">Chưa có danh mục</li>
                        </c:otherwise>
                    </c:choose>
                </ul>
            </div>

            <ul class="nav-links">
                <li><a href="${ctx}/home">Trang chủ</a></li>
                <li><a href="${ctx}/products">Thuốc</a></li>
                <li><a href="${ctx}/products?tag=health">Chăm sóc sức khỏe</a></li>
                <li><a href="${ctx}/products?tag=mother-baby">Mẹ &amp; Bé</a></li>
                <li>
                    <a href="${ctx}/products?promo=1">Khuyến mãi</a>
                    <span class="badge-sale">Giảm giá</span>
                </li>
            </ul>
        </nav>

        <div class="header-actions">
            <c:if test="${not empty sessionScope.currentUser and sessionScope.currentUser.roleName == 'KHACH_HANG'}">
                <a class="icon-btn" href="${ctx}/cart" title="Giỏ hàng">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/>
                        <path d="M3 3h2l2.5 12.5h11L21 7H7"/>
                    </svg>
                    <span class="icon-label">Giỏ hàng</span>
                </a>
            </c:if>
            <c:choose>
                <c:when test="${not empty sessionScope.currentUser}">
                    <c:if test="${sessionScope.currentUser.roleName == 'KHACH_HANG'}">
                        <a class="icon-btn" href="${ctx}/orders" title="Đơn hàng của tôi">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M6 2h12a1 1 0 0 1 1 1v18l-3-2-3 2-3-2-3 2-3-2V3a1 1 0 0 1 1-1z"/>
                                <path d="M9 7h6M9 11h6"/>
                            </svg>
                            <span class="icon-label">Đơn hàng</span>
                        </a>
                    </c:if>
                    <a class="icon-btn" href="${ctx}/profile" title="Hồ sơ của tôi">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/>
                        </svg>
                        <span class="icon-label"><c:out value="${sessionScope.currentUser.fullName}"/></span>
                    </a>
                    <a class="icon-btn" href="${ctx}/authen?action=logout" title="Đăng xuất">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5M21 12H9"/>
                        </svg>
                        <span class="icon-label">Đăng xuất</span>
                    </a>
                </c:when>
                <c:otherwise>
                    <a class="icon-btn" href="${ctx}/authen?action=login" title="Đăng nhập">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/>
                        </svg>
                        <span class="icon-label">Đăng nhập</span>
                    </a>
                </c:otherwise>
            </c:choose>
        </div>
    </div>
</header>
